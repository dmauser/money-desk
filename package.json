{
  "name": "money-desk",
  "version": "0.1.0",
  "description": "Your personal-finance AI team for GitHub Copilot CLI — 8 specialist agents (budget, tax, investing, retirement, debt, credit, insurance, estate), one install.",
  "type": "module",
  "bin": {
    "money-desk": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "extensions/money-desk/",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "copilot",
    "copilot-cli",
    "personal-finance",
    "budgeting",
    "tax-planning",
    "investing",
    "retirement",
    "debt",
    "credit"
  ],
  "author": "dmauser",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/installer.test.mjs tests/manifest-consistency.test.mjs tests/routes.test.mjs tests/guardrails.test.mjs",
    "test:watch": "node --test --watch tests/installer.test.mjs tests/manifest-consistency.test.mjs tests/routes.test.mjs tests/guardrails.test.mjs",
    "start": "node bin/cli.mjs help",
    "init": "node bin/cli.mjs init",
    "init:project": "node bin/cli.mjs init --project",
    "uninstall": "node bin/cli.mjs uninstall",
    "status": "node bin/cli.mjs status",
    "prepublishOnly": "npm test"
  }
}
