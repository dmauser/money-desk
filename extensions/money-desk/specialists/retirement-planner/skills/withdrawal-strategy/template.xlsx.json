  "sheets": [
    {
      "name": "Inputs",
      "cells": [
        {
          "ref": "A1",
          "value": "Withdrawal Strategy - Inputs",
          "style": "h1"
        },
        {
          "ref": "A2",
          "value": "Annual spending need"
        },
        {
          "ref": "B2",
          "value": 80000,
          "number_format": "$#,##0"
        },
        {
          "ref": "A3",
          "value": "Withdrawal horizon (years)"
        },
        {
          "ref": "B3",
          "value": 30,
          "number_format": "0"
        },
        {
          "ref": "A4",
          "value": "Real return (after inflation)"
        },
        {
          "ref": "B4",
          "value": 0.04,
          "number_format": "0.00%"
        },
        {
          "ref": "A5",
          "value": "Inflation rate"
        },
        {
          "ref": "B5",
          "value": 0.025,
          "number_format": "0.00%"
        },
        {
          "ref": "A6",
          "value": "Taxable account balance"
        },
        {
          "ref": "B6",
          "value": 400000,
          "number_format": "$#,##0"
        },
        {
          "ref": "A7",
          "value": "Traditional 401k/IRA balance"
        },
        {
          "ref": "B7",
          "value": 900000,
          "number_format": "$#,##0"
        },
        {
          "ref": "A8",
          "value": "Roth balance"
        },
        {
          "ref": "B8",
          "value": 300000,
          "number_format": "$#,##0"
        },
        {
          "ref": "A9",
          "value": "Effective income-tax rate (Trad. withdrawals)"
        },
        {
          "ref": "B9",
          "value": 0.18,
          "number_format": "0.00%"
        },
        {
          "ref": "A10",
          "value": "LTCG rate (taxable gains)"
        },
        {
          "ref": "B10",
          "value": 0.15,
          "number_format": "0.00%"
        },
        {
          "ref": "A11",
          "value": "Cost-basis % (taxable account)"
        },
        {
          "ref": "B11",
          "value": 0.55,
          "number_format": "0.00%"
        },
        {
          "ref": "A12",
          "value": "-- derived (do not edit) --"
        },
        {
          "ref": "A13",
          "value": "Total starting balance"
        },
        {
          "ref": "B13",
          "formula": "=taxable_balance_start+traditional_balance_start+roth_balance_start",
          "number_format": "$#,##0"
        },
        {
          "ref": "A14",
          "value": "Nominal return rate"
        },
        {
          "ref": "B14",
          "formula": "=(1+real_return_rate)*(1+inflation_rate)-1",
          "number_format": "0.00%"
        }
      ]
    },
    {
      "name": "Summary",
      "cells": [
        {
          "ref": "A1",
          "value": "Withdrawal Strategy - Summary",
          "style": "h1"
        },
        {
          "ref": "A3",
          "value": "Initial safe withdrawal rate"
        },
        {
          "ref": "B3",
          "formula": "=annual_spending/starting_total",
          "number_format": "0.00%"
        },
        {
          "ref": "A4",
          "value": "4% rule benchmark check"
        },
        {
          "ref": "B4",
          "formula": "=IF(annual_spending/starting_total<=0.04, \"At or below 4%\", \"Above 4% - higher risk\")"
        },
        {
          "ref": "A5",
          "value": "PV of spending (nominal annuity)"
        },
        {
          "ref": "B5",
          "formula": "=PV(nominal_return_rate, withdrawal_yrs, -annual_spending)",
          "number_format": "$#,##0"
        },
        {
          "ref": "A6",
          "value": "Surplus / shortfall vs starting"
        },
        {
          "ref": "B6",
          "formula": "=starting_total-B5",
          "number_format": "$#,##0"
        },
        {
          "ref": "A8",
          "value": "Gross-up needed (Traditional)"
        },
        {
          "ref": "B8",
          "formula": "=annual_spending/(1-effective_tax_rate)",
          "number_format": "$#,##0"
        },
        {
          "ref": "A9",
          "value": "Gross-up needed (Taxable, LTCG)"
        },
        {
          "ref": "B9",
          "formula": "=annual_spending/(1-ltcg_rate*(1-cost_basis_pct))",
          "number_format": "$#,##0"
        },
        {
          "ref": "A10",
          "value": "Gross-up needed (Roth)"
        },
        {
          "ref": "B10",
          "formula": "=annual_spending",
          "number_format": "$#,##0"
        },
        {
          "ref": "A12",
          "value": "Lowest-tax-cost source first"
        },
        {
          "ref": "B12",
          "formula": "=IF(roth_balance_start>=annual_spending, \"Roth (no tax)\", IF(taxable_balance_start>=annual_spending, \"Taxable (LTCG)\", \"Traditional (ordinary)\"))"
        }
      ]
    }
  ]
}